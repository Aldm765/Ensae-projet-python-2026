# Secrets : ne jamais publier
.env

# Données : stockées hors du dépôt (copie locale et S3)
data/*
*.csv
*.parquet
*.xlsx

# Exceptions : les petits tableaux d'annonces, versionnés comme secours
!data/annonces_*.csv

# Environnement virtuel
.venv/

# Fichiers générés automatiquement par Python et Jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/

# Exception : les prix bruts, pour que le rapport tourne sans Yahoo
!data/raw/
!data/raw/*.csv